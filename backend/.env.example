# Environment
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cleancentive
DB_PASSWORD=cleancentive_dev_password
DB_DATABASE=cleancentive

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Email / SMTP
# Development: Mailpit (local SMTP server with web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@cleancentive.local
# Production: Uncomment and configure for SendGrid, AWS SES, or other SMTP provider
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cleancentive-images
S3_REGION=us-east-1
UPLOAD_MAX_SIZE_BYTES=15728640
LOCATION_ACCURACY_SANITY_BOUND_METERS=10000
DETECTION_QUEUE_NAME=litter-detection

# API
API_PORT=3000
API_PREFIX=/api/v1
API_URL=https://cleancentive.local
FRONTEND_URL=https://cleancentive.local

# CORS
CORS_ORIGINS=https://cleancentive.local

# OIDC (Outline wiki SSO)
OIDC_ISSUER_URL=https://cleancentive.local/api/v1/oidc
OIDC_REDIRECT_URIS=https://wiki.cleancentive.local/auth/oidc.callback
# Must match the client secret configured in the OIDC client (e.g. Outline).
OIDC_CLIENT_SECRET=outline-dev-secret

# Outline API (auto-provision per-team wiki collections)
# The API key itself is auto-provisioned by OutlineSyncService at startup —
# no manual setup required. Only the URL needs configuring. The dev `bun run`
# scripts inject NODE_EXTRA_CA_CERTS so HTTPS to wiki.cleancentive.local works
# without an OS-level cert install. In prod, set this to the in-cluster URL.
OUTLINE_API_URL=https://wiki.cleancentive.local

# Public URL Outline uses to call our webhook endpoint. Must be reachable from
# inside the Outline container (in dev that's via Caddy on the host).
CLEANCENTIVE_PUBLIC_URL=https://cleancentive.local

# Admin
# Comma-separated list of emails that are automatically promoted to admin
ADMIN_EMAILS=

# Steward notifications
# Overrides ADMIN_EMAILS as the recipient for feedback notifications only.
# FEEDBACK_NOTIFY_EMAIL=

# Detection alerts. Stewards are mailed when detection needs a steward to act,
# once when it starts and once when it clears — not on every check. A standing
# problem repeats at most every DETECTION_ALERT_REPEAT_HOURS so a single missed
# mail cannot go unnoticed for days; set it to 0 to never repeat.
# Recipients come from the admins table (not ADMIN_EMAILS), so a steward needs a
# login-selected email address to be reachable.
# DETECTION_ALERT_ENABLED=false
DETECTION_ALERT_CRON=*/5 * * * *
DETECTION_ALERT_REPEAT_HOURS=24

# How long a spot may sit in queued/processing before it counts as stalled.
# Shared by the ops health badge, the retry sweep and the detection alert, so
# "stalled" means one thing everywhere.
DETECTION_HEALTH_STUCK_MINUTES=30
# Window the public /health/detection endpoint looks back over.
DETECTION_HEALTH_WINDOW_HOURS=24

# Storage warning threshold; emails admins once per 24h when exceeded.
STORAGE_WARNING_THRESHOLD_GB=50
# Delete original images older than this many days. Unset disables purging.
# IMAGE_PURGE_RETENTION_DAYS=

# --- Running costs ------------------------------------------------------
# The steward Cost page. Every vendor here degrades on its own: an unset key
# means that one row reads "unavailable", not that the page fails.

# Hetzner Cloud, read-only token (Console -> Security -> API tokens -> Read).
# Hetzner has no billing endpoint, so the current month is computed from live
# inventory x GET /v1/pricing. Do not reuse a read-write token for this.
# HETZNER_API_TOKEN=

# Reads the invoice PDFs attached to the wiki billing document, via Mistral OCR.
# Same key as the worker's DETECTION_API_KEY; named separately so invoice
# reading survives detection moving to a different provider.
# MISTRAL_API_KEY=

# The wiki document invoices are attached to, by urlId — the trailing half of a
# wiki link, e.g. rechnungen-fQnLX94fpZ. Documents filed under it are followed
# too. Unset disables invoice ingestion, which is the right default in dev.
# COST_INVOICE_DOC_ID=

# Resend, full-access key (a sending-only key cannot read /emails/metrics).
# Falls back to SMTP_PASS, which is a Resend API key when SMTP goes via Resend.
# RESEND_API_KEY=
# Resend plan, for turning the send count into money. The defaults describe the
# free tier; overage above the allowance is billed at $0.90 per 1000.
RESEND_PLAN_USD_PER_MONTH=0
RESEND_PLAN_INCLUDED_EMAILS=3000

# Spend alert. Stewards are mailed when the projected monthly total in CHF
# crosses the ceiling, once when it starts and once when it clears — a standing
# overspend repeats at most every COST_ALERT_REPEAT_HOURS. Unset or 0 disables
# the alert entirely; the page still works.
# COST_ALERT_MONTHLY_CHF=
# COST_ALERT_ENABLED=false
COST_ALERT_CRON=0 6 * * *
COST_ALERT_REPEAT_HOURS=168
