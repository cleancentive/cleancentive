# Environment
NODE_ENV=development

# Database (same as backend)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cleancentive
DB_PASSWORD=cleancentive_dev_password
DB_DATABASE=cleancentive

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Vision detection API — any OpenAI-compatible provider.
# DETECTION_BASE_URL defaults to OpenAI if unset. DETECTION_MODEL is required:
# there is deliberately no default, because a default silently pointed a
# non-OpenAI base URL at an OpenAI model name and recorded that false name as
# the detection's provenance.
DETECTION_API_KEY=your-api-key
DETECTION_BASE_URL=https://api.mistral.ai/v1
DETECTION_MODEL=mistral-medium-latest
DETECTION_QUEUE_NAME=litter-detection
DETECTION_MAX_IMAGE_SIZE=1024
# In-flight detections per worker process.
DETECTION_CONCURRENCY=2

# Prompt taxonomy. The known-label lists are snapshotted for this long rather
# than re-read per detection, so new labels reach the prompt at the next refresh
# instead of the next job — which keeps the prompt prefix stable enough to cache.
DETECTION_TAXONOMY_TTL_MS=600000
# Only the top N labels by actual usage go into the prompt. The worker mints a
# label from any new string a model returns, so these lists only ever grow.
DETECTION_MAX_OBJECT_LABELS=100
DETECTION_MAX_MATERIAL_LABELS=40
DETECTION_MAX_BRAND_LABELS=150

# Optional fallback providers, tried in order when the primary fails on its own
# side (no entitlement, auth, rate limit, 5xx). Numbering starts at 1 and stops
# at the first gap. Each needs at least _API_KEY and _MODEL.
# DETECTION_FALLBACK_1_API_KEY=your-openai-key
# DETECTION_FALLBACK_1_BASE_URL=https://api.openai.com/v1
# DETECTION_FALLBACK_1_MODEL=gpt-5-mini

# Plant identification (Pl@ntNet primary; Mistral fallback via the DETECTION_* config above)
# PLANT_IDENTIFIER: plantnet (default) | mistral | shadow:plantnet+mistral
PLANTNET_API_KEY=your-api-key
PLANTNET_BASE_URL=https://my-api.plantnet.org/v2
PLANTNET_PROJECT=weurope
# 0.3 keeps the invasive species we care about (knotweed @ 30%, hogweed @ 40%,
# goldenrod @ 38%) while excluding noise. UI renders 0.3–0.6 as "Probably X
# — verify" and ≥0.6 as a confident identification.
PLANTNET_MIN_CONFIDENCE=0.3
PLANT_IDENTIFIER=plantnet

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cleancentive-images
S3_REGION=us-east-1
