{
  # Use mkcert-issued certs for the *.cleancentive.local hostnames; disable
  # Caddy's auto-HTTPS (ACME + internal CA) since we bring our own.
  auto_https off
}

cleancentive.local {
  tls /certs/cleancentive.local.pem /certs/cleancentive.local-key.pem

  # Same as production, minus HSTS: pinning a .local name to HTTPS for a year
  # on a developer's machine is not worth the recovery it would need.
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
    -Server
  }

  @api path /api/*
  handle @api {
    reverse_proxy host.docker.internal:3000
  }

  handle {
    reverse_proxy host.docker.internal:5173
  }
}

wiki.cleancentive.local {
  tls /certs/cleancentive.local.pem /certs/cleancentive.local-key.pem
  reverse_proxy outline:3000
}

analytics.cleancentive.local {
  tls /certs/cleancentive.local.pem /certs/cleancentive.local-key.pem
  reverse_proxy umami:3000
}
